PORT=8080
APP_ENV=local
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kioshosting_dev
DB_SSLMODE=disable

# JWT Config (Required in production)
JWT_SECRET=kioshosting-dev-secret-change-in-production-min-32-chars

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Seed Credentials (Optional, defaults provided in dev mode)
SEED_ADMIN_PASSWORD=Admin123!@#_change_me
SEED_USER_PASSWORD=User123!@#_change_me
WHM_API_TOKEN=whm_tok_dev_change_me
PROXMOX_API_TOKEN=pve_tok_dev_change_me
